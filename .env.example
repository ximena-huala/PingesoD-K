# Variables para docker compose. Copia este archivo a .env y completa los valores.
#   cp .env.example .env

# Base de datos (el backend y el contenedor de Postgres comparten esta clave).
DB_PASSWORD=postgres

# Secreto para firmar los JWT. Usa uno largo (mínimo 32 caracteres) y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-chars

# Perfil de Spring. "dev" deja todo funcional en local (incluida la carga de Stock).
SPRING_PROFILES_ACTIVE=dev

# Orígenes que el navegador puede usar contra la API. En local basta el default.
# En un servidor hay que poner el dominio real desde el que se abre la app
# (ej: https://mi-dominio.com); si no coincide, el login devuelve 403 (Invalid CORS request).
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Credenciales de la API de Falabella (opcionales).
# Sin ellas la app arranca igual; solo el Explorador en vivo queda sin conexión.
FALABELLA_USER_ID=
FALABELLA_API_KEY=
FALABELLA_SELLER_ID=
