      }
    },
    {
      "name": "3. GetOrders (desde mayo 2026)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/?Action=GetOrders&Format=JSON&Timestamp={{timestamp}}&UserID={{userId}}&Version=1.0&Signature={{signature}}&CreatedAfter=2026-05-01T00:00:00-04:00",
          "host": ["{{baseUrl}}"],
          "path": [""],
          "query": [
            { "key": "Action", "value": "GetOrders" },
            { "key": "Format", "value": "JSON" },
            { "key": "Timestamp", "value": "{{timestamp}}" },
            { "key": "UserID", "value": "{{userId}}" },
            { "key": "Version", "value": "1.0" },
            { "key": "Signature", "value": "{{signature}}" },
            { "key": "CreatedAfter", "value": "2026-05-01T00:00:00-04:00" }
          ]
        },
        "description": "Órdenes creadas desde el 1 de mayo de 2026."
      }
    },
    {
      "name": "4. GetOrderItems (orden 1139186719)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/?Action=GetOrderItems&Format=JSON&Timestamp={{timestamp}}&UserID={{userId}}&Version=1.0&Signature={{signature}}&OrderId=1139186719",
          "host": ["{{baseUrl}}"],
          "path": [""],
          "query": [
            { "key": "Action", "value": "GetOrderItems" },
            { "key": "Format", "value": "JSON" },
            { "key": "Timestamp", "value": "{{timestamp}}" },
            { "key": "UserID", "value": "{{userId}}" },
            { "key": "Version", "value": "1.0" },
            { "key": "Signature", "value": "{{signature}}" },
            { "key": "OrderId", "value": "1139186719" }
          ]
        },
        "description": "Orden real de validación: debe devolver PaidPrice=50992.00 y ShippingAmount=3990.00 (ingreso bruto $54.982)."
      }
    }
  ]
}
