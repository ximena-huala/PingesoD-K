# Plantilla de variables de entorno del backend.
# Copia este archivo como .env (en esta misma carpeta) y rellena los valores.
# El .env está en .gitignore, así que nunca subas credenciales reales al repo.
# Spring lo lee solo al arrancar (config.import en application.yml).

# --- PostgreSQL ---
# Descoméntalo solo si tu Postgres no usa los valores por defecto.
# DB_URL=jdbc:postgresql://localhost:5432/dk_app
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# --- JWT ---
# En dev sirve el default; en producción hay que definirlo sí o sí.
# JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres

# --- Falabella ---
# Saca estos datos de Seller Center (cuenta admin del equipo). La API Key no
# viaja en las llamadas, solo se usa para firmarlas acá localmente.
#   USER_ID y API_KEY -> https://sellercenter.falabella.com/api-explorer
#   SELLER_ID         -> https://sellercenter.falabella.com/user/profile/account  (ID del Vendedor)
FALABELLA_USER_ID=email-del-seller@ejemplo.cl
FALABELLA_API_KEY=xxxxx
FALABELLA_SELLER_ID=12345

# --- Perfil ---
# Con dev se habilitan los endpoints /api/dev/falabella/* sin pedir token.
# SPRING_PROFILES_ACTIVE=dev
